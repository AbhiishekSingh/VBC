# ---------------------------------------------------------------------
# VBC configuration. Copy to .env and fill in.
# CREDENTIALS NEVER GO IN CODE OR IN THE DATABASE.
# ---------------------------------------------------------------------

VBC_DATABASE_URL=postgresql+psycopg://postgres:admin108@localhost:5432/vbc

# FileSure (MCA) — header is x-api-key
# fsk_test_… returns SANDBOX_ONLY for real DINs and sandbox:true on
# unlocks. A green sandbox run is NOT evidence the live path works.
VBC_FILESURE_API_KEY=fsk_test_7ed574ee-cb44-40a0-8710-8f55c1c4a5afA

# WhoisXML — one key, but credits are per-product POOLS, not one balance.
# Screenshots are the tightest at 10.
VBC_WHOISXML_API_KEY=at_My9dHgIYpm2Hx70o0BgX52pOQjyI9

# archive.org needs no key.

# ---------------------------------------------------------------------
# SPEND GUARD — leave false until you intend to spend real money.
# With this false, every billable call is refused rather than charged,
# so a misconfigured staging box cannot drain the FileSure wallet.
# ---------------------------------------------------------------------
VBC_ALLOW_PAID_CALLS=true

# Refuse to start a run estimated above this (paisa). 30000 = ₹300,
# enough for one company unlock plus a normal set of reads.


VBC_HTTP_TIMEOUT_SECONDS=300
VBC_HTTP_MAX_RETRIES=3
VBC_CORS_ORIGINS=http://localhost:5173
